# 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 본인 값을 넣으세요.
# .env 파일은 비밀번호와 같으니 GitHub에 올리면 안 됩니다. (.gitignore에 이미 제외되어 있음)

# 네이버 클라우드 플랫폼 > NAVER API HUB > Application > 인증 정보의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# NCBI(PubMed) API 키: 없어도 동작하지만 있으면 3배 빠름
NCBI_API_KEY=
NCBI_EMAIL=

# KIPRIS Plus(특허) 키: plus.kipris.or.kr > 마이페이지 > APIKEY관리의 REST AccessKey
KIPRIS_API_KEY=
